# Copia este archivo a .env y cambia los valores. Nunca subas .env a git.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/op-jccv
# Mínimo 16 caracteres. Genera uno propio, por ejemplo: openssl rand -hex 24
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Límite de intentos en /api/auth/login y /api/auth/register
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MIN=15

# Administrador inicial (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador
