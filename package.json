{
  "name": "op-jccv-api",
  "version": "0.1.0",
  "description": "Centro de Operaciones AI: backend para organizar actividades escolares, con pasos y planes de sesión.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "seed": "tsx src/scripts/seed.ts",
    "demo": "bash scripts/demo.sh",
    "demo2": "bash scripts/demo2.sh",
    "test:verbose": "jest --runInBand --verbose",
    "test:coverage": "jest --runInBand --coverage --collectCoverageFrom=src/domain/**/*.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
